"""Watson NLP emotion detection client."""

from __future__ import annotations

from typing import Any

import requests

WATSON_EMOTION_URL = (
    "https://sn-watson-emotion.labs.skills.network/v1/"
    "watson.runtime.nlp.v1/NlpService/EmotionPredict"
)
MODEL_HEADER = {"grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"}
EMOTIONS = ("anger", "disgust", "fear", "joy", "sadness")


def _empty_result() -> dict[str, None]:
    """Return the documented no-analysis result."""
    return {emotion: None for emotion in (*EMOTIONS, "dominant_emotion")}


def emotion_detector(text_to_analyze: str | None) -> dict[str, float | str | None]:
    """Analyze *text_to_analyze* with Watson NLP and return normalized emotions.

    Blank input and upstream failures return an all-``None`` result so callers can
    show a helpful validation message without exposing transport details.
    """
    if not isinstance(text_to_analyze, str) or not text_to_analyze.strip():
        return _empty_result()

    payload: dict[str, Any] = {"raw_document": {"text": text_to_analyze}}
    try:
        response = requests.post(
            WATSON_EMOTION_URL,
            headers=MODEL_HEADER,
            json=payload,
            timeout=15,
        )
        response.raise_for_status()
        body = response.json()
        emotion_scores = body["emotionPredictions"][0]["emotion"]
        result = {emotion: float(emotion_scores[emotion]) for emotion in EMOTIONS}
    except (KeyError, IndexError, TypeError, ValueError, requests.RequestException):
        return _empty_result()

    result["dominant_emotion"] = max(EMOTIONS, key=result.__getitem__)
    return result
